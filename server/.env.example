# Django设置
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1 # 限制「哪些 Host 头」可以访问你的 Django 服务，防止 Host 头攻击。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 # 允许哪些“前端来源”可以跨域访问你的 Django API
# AI模型API设置
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# 查重API设置
PLAGIARISM_API_KEY=your-plagiarism-api-key-here
PLAGIARISM_API_URL=https://api.example.com/plagiarism

# Redis设置 (用于Celery)
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_PASSWORD=redis

# MySQL数据库设置
DB_ENGINE=mysql
DB_NAME=pgcs_test
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306
